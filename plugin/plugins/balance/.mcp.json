{
  "mcpServers": {
    "balance": {
      "command": "cmd.exe",
      "cwd": ".",
      "args": [
        "/d",
        "/s",
        "/c",
        "call",
        "./scripts/launch_balance_mcp.cmd",
        "./server.mjs"
      ],
      "env_vars": [
        "PATH",
        "PATHEXT",
        "SystemRoot",
        "ComSpec",
        "TEMP",
        "TMP",
        "USERPROFILE",
        "LOCALAPPDATA",
        "APPDATA",
        "HOME",
        "CODEX_HOME",
        "CODEX_MCP_NODE_PATH",
        "CODEX_ELECTRON_RESOURCES_PATH",
        "DEEPSEEK_API_KEY",
        "BALANCE_API_KEY",
        "BALANCE_URL"
      ],
      "default_tools_approval_mode": "approve",
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 60
    }
  }
}
